# Copy to .env only when needed; .env is ignored.
HF_TOKEN=
LLM_BASE_URL=
LLM_API_KEY=
LLM_DECISION_MODEL=gpt-5.6-luna
LLM_VLM_MODEL=gpt-5.6-luna
LLM_IMAGE_MODEL=gpt-image-2

# Planned UI image search (G10); adapters are not wired into the runtime yet.
# Choose serpapi or tavily explicitly; Brave is not required.
LETSAIGC_IMAGE_SEARCH_PROVIDER=serpapi
# Canonical spelling is SERPAPI_API_KEY, not SEPAPI_API_KEY.
SERPAPI_API_KEY=
TAVILY_API_KEY=

COMFY_URL=http://127.0.0.1:8188
MLFLOW_URI=sqlite:///.local/mlflow/mlflow.db
MLFLOW_ARTIFACT_ROOT=.local/mlflow/artifacts
MLFLOW_HOST=127.0.0.1
MLFLOW_PORT=5000
